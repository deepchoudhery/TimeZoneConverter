<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>TimeZoneConvertor</RootNamespace>
    <AssemblyName>TimeZoneConvertor</AssemblyName>
    <LangVersion>latest</LangVersion>
    <!-- Properties\AssemblyInfo.cs is kept as the single source of assembly metadata -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CoreWCF.Primitives" Version="1.9.1" />
    <PackageReference Include="CoreWCF.Http" Version="1.9.1" />
  </ItemGroup>

</Project>