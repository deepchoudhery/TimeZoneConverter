{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "TimeZoneConverter": {
    // HTTPS endpoint E2 (BasicHttpBinding, Transport security) at /TimeZoneConverter.svc:
    //   "auto"  - only when Kestrel has an HTTPS listener (urls / https_ports / Kestrel:Endpoints)
    //   "true"  - always; set this per environment under IIS in-process hosting when the site has an
    //             https binding. Startup fails if the server then reports no https address.
    //   "false" - never
    "EnableHttpsEndpoint": "auto"
  }
}