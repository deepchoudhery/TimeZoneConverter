<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <!-- The in-process CoreWCF host runs on the ASP.NET Core shared framework. Referencing it directly
         lets NuGet prune the framework-provided packages (e.g. System.Security.Cryptography.Xml,
         Microsoft.AspNetCore.DataProtection) that CoreWCF depends on, as it already does for the host. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TimeZoneConverter\TimeZoneConverter.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.4.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <!-- Golden net481 wire baseline (task 01), byte-exact copies used by EndpointWireTests -->
    <None Update="WireBaseline\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>